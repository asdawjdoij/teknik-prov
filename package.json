{
  "name": "teknik-prov",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:seed": "node --experimental-strip-types --no-warnings scripts/seed.ts"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.2.3",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0-next.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.5.1",
    "prisma": "^8.0.0-rc.10",
    "svelte": "^5.56.7",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.11",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "valibot": "^1.4.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true
  }
}
